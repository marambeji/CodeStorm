// Schéma Prisma d'EcoNexus.
// Chaque "model" devient une table SQLite. Après modification :
//   npm run db:migrate   (crée/applique une migration + régénère le client)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ───── Module 1 : PlantDoc (Agriculture) ─────
model PlantDiagnosis {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id         String   @id @default(cuid())
  parcel     String // nom de la parcelle (ex : "Parcelle Nord")
  crop       String // culture : tomate, pomme-de-terre, vigne...
  diseaseKey String // identifiant de la maladie (base de connaissances, ex : "tomate-mildiou")
  disease    String // nom lisible (ou "Plante saine")
  confidence Float // 0 → 1, donné par le modèle de vision
  severity   String // "aucune" | "faible" | "moyenne" | "élevée"
  advice     String // conseil de traitement en langage simple (IA)
  tips       String // conseils complémentaires, JSON (liste de textes)
  status     String   @default("a-traiter") // "a-traiter" | "en-cours" | "traite"
  notes      String?
  imageUrl   String?
  details    String? // analyse détaillée de l'IA (JSON) : maladie hors catalogue, symptômes observés, alternatives
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ───── IrriPlan (Eau · Énergie · Agriculture) ─────
// Planning d'irrigation sur 7 jours, calculé (méthode FAO-56) à partir de la météo réelle.
model IrrigationPlan {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  name         String
  terrainId    String? // terrain TerraCalc d'origine (facultatif)
  speciesId    String
  areaM2       Float
  trees        Int? // nombre d'arbres (null pour une culture annuelle)
  lat          Float
  lng          Float
  irrigation   String // "goutte-a-goutte" | "aspersion" | "gravitaire"
  plantingYear Int?
  pumpHeadM    Float    @default(30) // hauteur de pompage (m), pour l'énergie
  kwhPrice     Float    @default(0.25) // prix du kWh (€)
  plan         String // plan calculé + conseils IA, en JSON (jours, volumes, énergie…)
  doneDays     String   @default("[]") // dates (AAAA-MM-JJ) où l'irrigation a été faite, JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ───── Module 4 : AquaScan (Eau) ─────
model Meter {
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  id        String         @id @default(cuid())
  name      String // ex : "Compteur maison"
  location  String?
  readings  MeterReading[]
  createdAt DateTime       @default(now())

  @@index([userId])
}

model MeterReading {
  id            String   @id @default(cuid())
  meter         Meter    @relation(fields: [meterId], references: [id], onDelete: Cascade)
  meterId       String
  value         Float // index du compteur en m³
  readAt        DateTime // date du relevé
  source        String   @default("ocr") // "ocr" | "manuel"
  ocrConfidence Float? // confiance de la lecture automatique (0 → 1)
  note          String?
  photoUrl      String? // photo du compteur (si relevé par photo)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ───── Module 5 : TerraCalc (Agriculture) ─────

// Table de référence agronomique (remplie par le seed). Valeurs indicatives moyennes.
model Species {
  id                      String    @id // slug lisible : "olivier", "palmier-dattier"...
  name                    String
  kind                    String // "tree" (arbre / vigne) | "crop" (culture annuelle)
  description             String
  climate                 String // climat adapté
  droughtTolerance        String // "faible" | "moyenne" | "élevée"
  // Arbres : espacement recommandé (m) entre rangs et sur le rang
  rowSpacingM             Float?
  treeSpacingM            Float?
  // Arbres : besoin en eau d'un arbre adulte (m³ / arbre / an)
  waterM3PerTreeYear      Float?
  firstProductionAge      Int? // âge de la première récolte (ans)
  fullProductionAge       Int? // âge de pleine production (ans)
  fullYieldKgPerTree      Float? // rendement d'un arbre en pleine production (kg / an)
  lifespanYears           Int?
  plantCostEur            Float? // prix d'un plant
  maintenanceEurPerTreeYr Float?
  co2KgPerTreeYear        Float? // CO2 absorbé par un arbre adulte
  // Cultures annuelles : valeurs par hectare
  yieldKgPerHa            Float?
  waterM3PerHaYear        Float?
  costEurPerHa            Float? // coût d'une campagne (semences, travail du sol...)
  co2KgPerHaYear          Float?
  pricePerKgEur           Float // prix de vente moyen, modifiable par l'utilisateur
  terrains                Terrain[]
}

model Terrain {
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  name         String
  polygon      String // GeoJSON Polygon, stocké en texte JSON
  areaM2       Float
  perimeterM   Float
  centroidLat  Float
  centroidLng  Float
  species      Species? @relation(fields: [speciesId], references: [id])
  speciesId    String?
  plantingYear Int? // null = terrain vide, plantation future
  rowSpacingM  Float?
  treeSpacingM Float?
  irrigation   String? // "goutte-a-goutte" | "aspersion" | "gravitaire" | "pluvial"
  pricePerKg   Float? // prix personnalisé (sinon celui de l'espèce)
  estimate     String? // dernière estimation calculée, en JSON
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ───── Comptes ─────
// Trois rôles : "agriculteur" (outils + vente), "client" (achète), "livreur" (livre).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("agriculteur") // "agriculteur" | "client" | "livreur"
  phone        String?
  farmName     String?
  placeName    String?
  lat          Float?
  lng          Float?
  // Livreur : dernière position GPS partagée pendant une tournée (suivi en direct)
  liveLat      Float?
  liveLng      Float?
  liveAt       DateTime?
  createdAt    DateTime @default(now())

  terrains  Terrain[]
  diagnoses PlantDiagnosis[]
  plans     IrrigationPlan[]
  meters    Meter[]

  products         Product[]
  ordersAsClient   Order[]   @relation("ClientOrders")
  ordersAsFarmer   Order[]   @relation("FarmerOrders")
  ordersAsCourier  Order[]   @relation("CourierOrders")

  // Traçabilité (module additif)
  harvestLots      HarvestLot[] @relation("FarmerLots")
  traceBlocks      TraceBlock[] @relation("TraceActor")
}

// ───── Marché : de la ferme au client (agriculteur → livreur → client) ─────

model Product {
  id          String      @id @default(cuid())
  farmerId    String
  farmer      User        @relation(fields: [farmerId], references: [id], onDelete: Cascade)
  name        String
  category    String // "legumes" | "fruits" | "cereales" | "huiles" | "dattes" | "miel" | "autres"
  unit        String // "kg" | "litre" | "piece" | "botte" | "caisse"
  price       Float // prix par unité
  stock       Float // quantité disponible, dans l'unité
  description String?
  origin      String? // parcelle / lieu de production (traçabilité)
  harvestDate DateTime? // date de récolte (traçabilité)
  organic     Boolean     @default(false)
  photoUrl    String?
  active      Boolean     @default(true) // retiré de la vente sans être supprimé
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([farmerId])
  @@index([active, category])
}

// Une commande = un client + un agriculteur (un panier multi-fermes donne plusieurs commandes).
// Statuts : en_attente → acceptee → prete → prise_en_charge → en_livraison → livree  (ou refusee / annulee)
model Order {
  id           String       @id @default(cuid())
  reference    String       @unique // ex : "EN-7K3Q9P"
  clientId     String
  client       User         @relation("ClientOrders", fields: [clientId], references: [id], onDelete: Cascade)
  farmerId     String
  farmer       User         @relation("FarmerOrders", fields: [farmerId], references: [id], onDelete: Cascade)
  courierId    String?
  courier      User?        @relation("CourierOrders", fields: [courierId], references: [id], onDelete: SetNull)
  status       String       @default("en_attente")
  address      String
  deliveryLat  Float? // point de livraison choisi sur la carte par le client
  deliveryLng  Float?
  pickupLat    Float? // position de la ferme au moment de la commande
  pickupLng    Float?
  phone        String
  note         String?
  subtotal     Float
  deliveryFee  Float
  total        Float
  deliveryCode String // code à 4 chiffres que le client donne au livreur à la remise
  items        OrderItem[]
  events       OrderEvent[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([clientId])
  @@index([farmerId])
  @@index([courierId])
  @@index([status])
}

// Ligne de commande : nom et prix figés au moment de l'achat
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String
  unit      String
  unitPrice Float
  quantity  Float
  lineTotal Float
}

// Journal de traçabilité : chaque étape, qui l'a faite et quand
model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  actorRole String
  actorName String
  note      String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// ───── Traçabilité : de la récolte au consommateur (registre chaîné, style blockchain) ─────
// Module additif : il ne modifie ni le marché ni les comptes. Chaque lot de récolte reçoit un code
// unique (QR) ; chaque acteur (agriculteur → collecteur → transporteur → distributeur) ajoute un
// « bloc » signé dont le hash dépend du bloc précédent : toute modification casse la chaîne.
model HarvestLot {
  id          String       @id @default(cuid())
  code        String       @unique // identifiant unique du lot, ex : "LOT-7K3Q9P" (encodé dans le QR)
  farmerId    String
  farmer      User         @relation("FarmerLots", fields: [farmerId], references: [id], onDelete: Cascade)
  product     String // nom du produit récolté
  category    String // mêmes catégories que le marché
  variety     String?
  quantity    Float
  unit        String
  parcel      String? // parcelle d'origine
  placeName   String?
  lat         Float?
  lng         Float?
  harvestDate DateTime
  organic     Boolean      @default(false)
  notes       String?
  certificate String // sceau HMAC du bloc d'origine : certification de l'origine par la plateforme
  stage       String       @default("recolte") // dernière étape enregistrée
  blocks      TraceBlock[]
  createdAt   DateTime     @default(now())

  @@index([farmerId])
}

model TraceBlock {
  id          String     @id @default(cuid())
  lotId       String
  lot         HarvestLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  index       Int // position dans la chaîne (0 = bloc d'origine)
  stage       String // "recolte" | "collecte" | "transport" | "stockage" | "distribution" | "vente"
  actorId     String?
  actor       User?      @relation("TraceActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorRole   String // rôle dans la chaîne : agriculteur | collecteur | transporteur | distributeur | detaillant
  actorName   String
  placeName   String?
  lat         Float?
  lng         Float?
  temperature Float? // °C mesurée à cette étape (sert à prédire la conservation)
  quantity    Float? // quantité constatée (pertes éventuelles)
  note        String?
  prevHash    String
  hash        String
  createdAt   DateTime   @default(now())

  @@unique([lotId, index])
  @@index([actorId])
}
