# ─── EcoNexus · configuration du backend ───────────────────────────
# Copie ce fichier en ".env" (cp .env.example .env) puis complète-le.
# Le fichier .env n'est JAMAIS commité (il contient des secrets).

# Port de l'API NestJS
PORT=3000

# URL(s) du frontend autorisées par CORS (séparées par des virgules)
FRONTEND_URL=http://localhost:5173

# Base de données SQLite (fichier local, créé automatiquement)
DATABASE_URL="file:./dev.db"

# ─── IA (LLM) ──────────────────────────────────────────────────────
# Laisse LLM_API_KEY vide pour la démo : l'AiService renverra alors
# des réponses simulées réalistes (fonctionne sans internet).
# LLM_PROVIDER et LLM_MODEL : fournisseur et modèle du LLM, à renseigner avec la clé.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
LLM_API_KEY=
LLM_VISION_MODEL=gemini-3.8-flash

# Clé de signature des jetons de connexion (32 octets minimum) : openssl rand -base64 48
JWT_SECRET=
